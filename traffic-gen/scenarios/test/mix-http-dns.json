{
  "name": "mix-http-dns",
  "duration_sec": 30,
  "max_concurrency": 100,
  "target_cps": 20,
  "report_interval_sec": 1,
  "classes": [
    {
      "name": "http_get",
      "weight": 7,
      "transport": "tcp",
      "peer": {
        "ip": "192.168.21.106",
        "port": 8888
      },
      "http": {
        "method": "GET",
        "path": "/",
        "keepalive": false
      }
    },
    {
      "name": "dns_a",
      "weight": 3,
      "transport": "udp",
      "peer": {
        "ip": "192.168.21.106",
        "port": 53
      },
      "dns": {
        "qname": "www.example.local",
        "qtype": "A"
      }
    }
  ]
}